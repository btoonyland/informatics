# Downloaded and intermediate data (large; regenerate with the pipeline). The small pointer
# files DVC writes for the raw data (data/raw/*.dvc, see dvc.yaml) are committed.
data/*
!data/raw/
data/raw/*
!data/raw/*.dvc

# Per-paper result tables can be large; summary tables next to them are committed
results/**/papers.parquet
results/**/papers.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Records saved by the live tests (INFORMATICS_RECORD_DIR); review before moving to tests/fixtures
recorded/
